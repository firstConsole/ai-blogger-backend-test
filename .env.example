# Общее
# local | staging | production. В production включаются строгие проверки:
# запрещён debug, шаблонные секреты и текстовый формат логов.
ENVIRONMENT=local
DEBUG=false

# Telegram
TELEGRAM__BOT_TOKEN=
# Чат, куда приходят карточки постов на подтверждение
TELEGRAM__ADMIN_CHAT_ID=
TELEGRAM__API_ID=
TELEGRAM__API_HASH=
TELEGRAM__SESSION_PATH=data/telethon.session

# PostgreSQL
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=ai_blogger
POSTGRES__PASSWORD=
POSTGRES__DATABASE=ai_blogger

# Redis (очередь TaskIq)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DATABASE=0
REDIS__PASSWORD=

# LLM
LLM__ANTHROPIC_API_KEY=
LLM__OPENAI_API_KEY=
LLM__DEEPSEEK_API_KEY=
LLM__DRAFT_MODEL=claude-sonnet-5
LLM__CRITIC_MODEL=gpt-5.4-nano
LLM__IMAGE_MODEL=gpt-image-2
LLM__DIGEST_MODEL=deepseek-v4

# ── (S3-совместимое, Cloudflare R2)
STORAGE__ENDPOINT_URL=
STORAGE__ACCESS_KEY_ID=
STORAGE__SECRET_ACCESS_KEY=
STORAGE__BUCKET=ai-blogger-media
STORAGE__PUBLIC_BASE_URL=

# Brave Search
SEARCH__API_KEY=
SEARCH__MONTHLY_QUERY_BUDGET=600

# Безопасность
# Ключ шифрования секретов канала в базе. Минимум 32 байта.
# Сгенерировать:  openssl rand -base64 48
SECURITY__SECRETS_ENCRYPTION_KEY=
SECURITY__ADMIN_SESSION_TTL_MINUTES=720
SECURITY__INVITE_MAX_ATTEMPTS=5

# Логи и метрики
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_FORMAT=console
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__METRICS_PORT=9090
